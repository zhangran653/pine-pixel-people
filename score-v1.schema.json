{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "松溪人物动作编排 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "loop": {
      "type": "boolean",
      "default": false,
      "description": "到达整套编排末尾后回到开头。"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "scene": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/placement"
      }
    },
    "detail": {
      "enum": ["figure", "standard"],
      "default": "figure",
      "description": "场景中人物和程序生成物件的采样精度。"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "actors"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/id",
          "description": "已注册的动作 ID。"
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "按动作声明的角色顺序填写人物 ID。运行时校验人数与每个槽位的标签。"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "播放一次的秒数，省略时使用动作默认时长。"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "description": "场景中的物件序号，从 0 开始。物件类别须与动作的 station 相同。"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number",
          "minimum": -256,
          "maximum": 256
        },
        "y": {
          "type": "number",
          "minimum": -256,
          "maximum": 256
        },
        "z": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "heading": {
          "type": "number",
          "minimum": -6.283185307179586,
          "maximum": 6.283185307179586
        }
      }
    }
  }
}
