  "if": {
    "properties": {
      "parts": {
        "properties": {
          "hat": {
            "pattern": "^(none$|pine-core/)"
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "packs": {
        "maxProperties": 1
      },
      "embeddedPacks": {
        "maxItems": 0
      }
    }
  },
  "else": {
    "properties": {
      "packs": {
        "minProperties": 2
      }
    }
