{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "松溪像素形象 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "label",
    "base",
    "packs",
    "shape",
    "parts",
    "colors"
  ],
  "properties": {
    "format": {
      "const": "pine-character"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^look_[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "\\S"
    },
    "base": {
      "enum": [
        "child",
        "adult"
      ]
    },
    "packs": {
      "type": "object",
      "required": [
        "pine-core"
      ],
      "maxProperties": 2,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "properties": {
        "pine-core": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0",
            "1.4.0",
            "1.5.0",
            "1.6.0",
            "1.6.1",
            "1.7.0",
            "1.8.0",
            "1.9.0",
            "1.9.1"
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "shoulders",
        "arms",
        "legs",
        "faceWidth",
        "eyeSpacing",
        "jaw",
        "mouthHeight"
      ],
      "properties": {
        "height": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.3,
          "default": 1
        },
        "shoulders": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.35,
          "default": 1
        },
        "arms": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.25,
          "default": 1
        },
        "legs": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.25,
          "default": 1
        },
        "faceWidth": {
          "type": "number",
          "minimum": 0.84,
          "maximum": 1.16,
          "default": 1
        },
        "eyeSpacing": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2,
          "default": 1
        },
        "jaw": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2,
          "default": 1
        },
        "occiput": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.2,
          "default": 1
        },
        "mouthHeight": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0
        }
      }
    },
