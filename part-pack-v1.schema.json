{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "松溪帽饰部件包 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "release",
    "title",
    "author",
    "license",
    "parts"
  ],
  "properties": {
    "format": {
      "const": "pine-parts"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "release": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "slot",
          "primitives"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "slot": {
            "const": "hat"
          },
          "primitives": {
            "type": "array",
            "minItems": 1,
            "maxItems": 96,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shape",
                "center",
                "size",
                "color"
              ],
              "properties": {
                "shape": {
                  "enum": [
                    "ellipsoid",
                    "box"
                  ]
                },
                "center": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2
                  }
                },
                "size": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": 0.005,
                    "maximum": 2
                  }
                },
                "color": {
                  "enum": [
                    "hatMain",
                    "hatShade",
                    "hatLight",
                    "hatTrim",
                    "hatInk"
                  ]
                },
                "power": {
                  "type": "number",
                  "minimum": 2,
                  "maximum": 6
                }
              },
              "if": {
                "properties": {
                  "shape": {
                    "const": "box"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "power"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    }
  }
}
